                "stringUnit": {
                  "state": "translated",
                  "value": "macOS refused to change the tracking speed of %lld devices."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "macOS не позволила изменить скорость %lld устройств."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "macOS не позволила изменить скорость %lld устройств."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "macOS не позволила изменить скорость %lld устройства."
                }
