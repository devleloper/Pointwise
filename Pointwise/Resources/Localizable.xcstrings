      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить указатель"
          }
        }
      }
    },
    "Reset Scrolling": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить прокрутку"
          }
        }
      }
    },
    "Responsiveness": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзывчивость"
          }
        }
      }
    },
