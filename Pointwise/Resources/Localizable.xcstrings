      }
    },
    "Slow movements move %@ points per count; fast movements move %@ points per count.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленные движения дают %1$@ точки на отсчёт, быстрые — %2$@."
