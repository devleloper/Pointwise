    },
    "macOS setting": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка macOS"
          }
        }
      }
    },
    "macOS settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки macOS"
          }
        }
      }
    },
    "macOS uses one tracking value for both speed and acceleration: higher values move faster and accelerate more. With acceleration off, the pointer moves exactly as far as the mouse reports, so its speed follows the mouse's DPI setting. macOS doesn't let apps change speed and acceleration separately.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS задаёт скорость и ускорение одним значением: чем оно больше, тем быстрее указатель и сильнее ускорение. Без ускорения указатель смещается ровно на столько, сколько сообщает мышь, поэтому скорость зависит от её DPI. macOS не позволяет приложениям менять скорость и ускорение по отдельности."
          }
        }
      }
    },
    "the standard macOS curve": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "стандартная кривая macOS"
          }
        }
      }
    }
  },
  "version": "1.0"
}