    },
    "Restore defaults?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить настройки по умолчанию?"
          }
        }
      }
    },
    "Restore every mouse and scrolling option to its default.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть все настройки мышей и прокрутки к значениям по умолчанию."
          }
        }
      }
    },
    "Reverse horizontal scrolling": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратная горизонтальная прокрутка"
          }
        }
      }
    },
    "Reverse vertical scrolling": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратная вертикальная прокрутка"
          }
        }
      }
    },
    "Reverses the mouse wheel relative to macOS Natural scrolling, which is off. The trackpad keeps the macOS direction.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет направление колеса относительно «Естественной прокрутки» macOS (сейчас выключена). Трекпад сохраняет направление macOS."
          }
        }
      }
    },
    "Reverses the mouse wheel relative to macOS Natural scrolling, which is on. The trackpad keeps the macOS direction.": {
      "localizations": {
        "ru": {
          "stringUnit": {
