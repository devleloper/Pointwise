    "its own acceleration curves": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "собственные кривые ускорения"
          }
        }
      }
    },
    "macOS needs your approval in Login Items.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ждёт вашего подтверждения в «Объектах входа»."
          }
        }
      }
    },
    "macOS refused to change the tracking speed of %lld device(s).": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "macOS refused to change the tracking speed of %lld device."
                }
              },
